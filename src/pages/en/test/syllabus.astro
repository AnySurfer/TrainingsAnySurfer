---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'

const title = 'Web accessibility for testers'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!-- Source: Input/reveal/test_en.html -->
<LayoutSyllabus title={title} lang="en" slidesHref={`${base}/en/test/`}>
  <EnTestRequirements />
  <EnTestUsers />
  <EnTestTools />
  <EnTestAccessibilityTree />
  <EnTestBrowserTools />
  <EnTestSimpleTests />
  <EnTestPageTitles />
  <EnTestLanguage />
  <EnTestStructure />
  <EnTestImages />
  <EnTestKeyboard />
  <EnTestVisualChecks />
  <EnTestColor />
  <EnTestContrast />
  <EnTestOrientation />
  <EnTestResizeText />
  <EnTestReflow />
  <EnTestTextSpacing />
  <EnTestScreenReader />
  <EnTestLinearReading />
  <EnTestForms />
  <EnTestCustomComponents />
  <EnTestAutomatedTesting />
  <EnTestContact />
</LayoutSyllabus>
