  <section>
    <h2>Contrôle sur le mouvement</h2>
    <a href="http://www.pass.be" class="image-link">
      <img
        class="stretch"
        src="http://images.anysurfer.be/perturbations/bouton_pause.png"
        alt="Diaporama avec bouton pause sur le site du pass"
      />
