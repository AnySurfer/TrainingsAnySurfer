<section>
  <section id="tables">
    <h1>6. Tableaux</h1>
    <p>Les tableaux doivent être structurés correctement</p>
  </section>

  <section>
    <p>
      <a href="https://examples.anysurfer.be/tables/tabelhoofdingen_fr.html">
        <img
          src="https://images.anysurfer.be/table/tableau_revenus.png"
          alt="exemple de tableau : revenus moyen mensuel en EUR de 2014 à 2016  pour 5 pays"
        />
      </a>
    </p>
  </section>

