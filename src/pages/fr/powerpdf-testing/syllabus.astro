---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'

const title = "Tester l'accessibilité d'un document PDF"
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!-- Source : Input/reveal/fr/pdf/powerpdf_tester_fr.html -->
<LayoutSyllabus
  title={title}
  lang="fr"
  slidesHref={`${base}/fr/powerpdf-testing/`}>
  <FrPdfTestingIntroduction />
  <FrPdfAdobeReaderInspection />
  <FrPdfTextConversion />
  <FrPowerpdfInspection />
  <FrPdfAcrobatInspection />
  <FrPdfAccessibilityChecker title="Autre vérificateur d'accessibilité" />
  <FrPdfScreenReaderTesting />
</LayoutSyllabus>
