---
import type { ImageMetadata } from 'astro'
import { defaultLang, type Locale } from '../../i18n/config'

import LogoEN from '@assets/img/logo/logo_AS_baseline_en.png'
import LogoFR from '@assets/img/logo/logo_AS_baseline_fr.png'
import LogoNL from '@assets/img/logo/logo_AS_baseline_nl.png'

interface Props {
  lang?: Locale
}
const { lang: requestedLang = Astro.currentLocale } = Astro.props

const logos = {
  en: {
    image: LogoEN,
    alt: 'AnySurfer — towards an accessible internet',
  },
  fr: {
    image: LogoFR,
    alt: 'AnySurfer — pour un Internet plus accessible',
  },
  nl: {
    image: LogoNL,
    alt: 'AnySurfer — voor een toegankelijker internet',
  },
} satisfies Record<Locale, { image: ImageMetadata; alt: string }>

const entries = Object.entries(logos)
const selectedLogo =
  entries.find(([lang]) => lang === requestedLang) ??
  entries.find(([lang]) => lang === defaultLang)

if (!selectedLogo) {
  throw new Error('No logo configured for the default locale.')
}

const [_, logo] = selectedLogo
const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`
---

<a class="brand" href={homeHref} data-logos={JSON.stringify(logos)}>
  <img
    src={logo.image.src}
    width={logo.image.width}
    height={logo.image.height}
    alt={logo.alt}
  />
</a>

<style>
  .brand {
    box-shadow: var(--as-elevation-1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand {
      opacity: 0.9;
      transition:
        border-color 180ms ease,
        box-shadow 180ms ease,
        opacity 180ms ease;
    }
    .brand:hover,
    .brand:focus-within {
      opacity: 1;
      border-color: var(--as-text);
      box-shadow: var(--as-elevation-2);
    }
  }
</style>
