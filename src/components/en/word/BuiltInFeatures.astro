<section id="word-built-in-features">
					<section>
						<h1>Use built in features</h1>
						<ul>
							<li>Footnotes</li>
							<li>Table of content</li>
							<li>Footers & Page numbering</li>

						</ul>

					</section>

					<section>
						<h2>Footnotes</h2>
						<img src="https://images.anysurfer.be/applications/Word365/insert_footnote.jpg" alt="">
						<ul>
							<li>References > Insert Footnote</li>
							<li>Visually text is at the bottom</li>
							<li>But in PDF tag structure and for screenreader, it is at the end of current paragraph</li>

						</ul>

					</section>

					<section>
						<h2>Table of contents</h2>
						<ul>
							<li>References > Table of contents</li>
							<li>Specials TOC tags (not headings)</li>
						</ul>

					</section>

					<section>
						<h2>headers and footers</h2>
						<img src="https://images.anysurfer.be/applications/Word365/header_footer_pagenum.jpg" alt="">
					</section>
					<section>
						<h2>Page numbering & footers</h2>
						<ul>
							<li>Insert > Page numbering</li>
							<li>Choose simple page numbers, not the ones with graphical elements</li>
							<li>Page numbers and other info in the footer are not accessible. That's OK</li>
							<li>Don't put important info only in the footer (or header). </li>
						</ul>
					</section>

					<section>
						<h2>Try it yourself</h2>
						<ol>
							<li>Create a new document containing two recipes</li>
							<li>Start each recipe on a new page</li>
							<li>Add a footnote with a link to the source of the recipe</li>
							<li>Add page numbers</li>
							<li>Add a table of contents</li>
							<li>Check accessibility and convert to PDF</li>
						</ol>
					</section>
				</section>
