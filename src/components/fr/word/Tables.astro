<section id="tables">
  <section>
    <h1>Tableaux</h1>
  </section>

  <section>
    <h2>Créer un tableau</h2>
    <a href="https://anysurfer.be/fr/en-pratique/documents/word#tabel">
      <img
        src="https://images.anysurfer.be/applications/Word365/ins_tableau.jpg"
        alt="Fenêtre de dialogue Créer un tableau"
      />
    </a>
    <p>Insertion > tableau</p>
  </section>

  <section>
    <h2>Indiquer les en-têtes de tableau</h2>
    <img
      src="https://images.anysurfer.be/applications/Word365/tableau_entete.jpg"
      alt="deux cases à cocher cochées"
    />
    <p>Dans "création de tableau"</p>
    <ul>
      <li>Cocher "Ligne-d'en-tête" pour en-têtes dans la première ligne</li>
      <li>Cocher "Première colonne" pour en-têtes dans la première colonne</li>
    </ul>
  </section>

  <section>
    <h2>Donner une légende à un tableau</h2>
    <img
      src="https://images.anysurfer.be/applications/Word365/ins_legende.jpg"
      alt=""
    />
    <p>Sélectionner tout le tableau > click droit > Insérer une légende</p>
  </section>

  <section>
    <h2>Un tableau doit être simple</h2>
    <img
      src="https://images.anysurfer.be/table/tableau_simple.png"
      alt="tableau simple avec une ligne d'en-têtes"
    />
  </section>

  <section>
    <p>Evitez les tableaux complexes</p>
    <img
      class="stretch"
      src="https://images.anysurfer.be/table/tableau_trop_complexe.png"
      alt="tableau avec multiples niveaux d'entêtes, à plusieurs endroits du tableau"
    />
  </section>
</section>
