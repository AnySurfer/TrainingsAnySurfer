import Tommy from '@assets/img/tommy.png'
---

<!-- NEW VERSION (09/02/2021) -->

<section id="tommy">
  <h1 class="persona_title">Tom has reading difficulties</h1>
  <img src={Tommy.src} class="stretch" alt="Tommy" />
</section>

<section>
  <blockquote>
    "I've received a letter from the government, but I don't understand what
    they're asking me to do."
  </blockquote>
</section>

<section>
  <p>Tom understands simple texts with everyday words.</p>
</section>

