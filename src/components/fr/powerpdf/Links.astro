---
import ImageLink001 from '@assets/img/powerpdf/link-001.png'
import ImageLink002 from '@assets/img/powerpdf/link-002.png'
import ImageLink003 from '@assets/img/powerpdf/link-003.png'
---

<section id="links">
  <section>
    <h2>Baliser un lien (1/4)</h2>
    <ul>
      <li>
        <p>
          Ajouter une balise de lien dans la structure des balises et
          sélectionner
        </p>
      </li>
      <li>
        <p>Sélection du texte du lien dans le document</p>
      </li>
      <li>
        <p>Texte du lien à lier</p>
      </li>
    </ul>
    <img src={ImageLink001.src} alt="" />
  </section>

  <section>
    <h2>Baliser un lien (2/4)</h2>
    <p>Créer le lien</p>
    <img src={ImageLink002.src} alt="" />
  </section>

  <section>
    <h2>Baliser un lien (3/4)</h2>
    <ul>
      <li>
        <p>Placer le curseur devant le lien du document</p>
      </li>
      <li>
        <p>Panneau "Tag" > Recherche</p>
      </li>
      <li>
        <p>Sélectionner "Liens non marqués</p>
        <img src={ImageLink003.src} alt="" />
      </li>
      <li>
        <p>Cliquez sur "Rechercher"</p>
      </li>
      <li>
        <p>
          Lorsque vous avez trouvé les liens corrects, cliquez sur "Élément de
          balisage"
        </p>
      </li>
      <li>
        <p>Cela ajoute une balise "Link - OBJR" dans la balise Link</p>
      </li>
    </ul>
  </section>

  <section>
    <h2>Baliser un lien (4/4)</h2>
    <p>Ajouter une alternative textuelle</p>
  </section>

  <section>
    <h2>Exercice</h2>
    <p>Ajouter des balises à un PDF non balisé</p>
  </section>
</section>
