---
import Layout from '@layouts/Layout.astro'
import trainings from '@data/training-pages.json'
import { defaultLang, languages } from '../i18n/ui'
import { getPreferredLang, useTranslations } from '../i18n/utils'

const locale = import.meta.env.DEV
  ? getPreferredLang([Astro.preferredLocale ?? defaultLang])
  : defaultLang
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const sections = (['fr', 'nl', 'en'] as const)
  .map((lang) => {
    const localizedTrainings = trainings.filter(
      (training) => training.lang === lang,
    )
    const featured = localizedTrainings.filter((training) => training.featured)
    return {
      lang,
      t: useTranslations(lang),
      trainings: (featured.length ? featured : localizedTrainings).slice(0, 4),
    }
  })
  .sort((a, b) => Number(b.lang === locale) - Number(a.lang === locale))
---

<Layout title={t('home.title')} lang={locale}>
  <div class="page-intro">
    <p class="eyebrow">{t('home.label')}</p>
    <h1>{t('home.title')}</h1>
    <p>{t('home.description')}</p>
  </div>
  {sections.map(({ lang, t, trainings }) => (
    <section
      class="language-section"
      lang={lang}
      aria-labelledby={`language-${lang}`}>
      <header class="language-header">
        <h2 id={`language-${lang}`}>{languages[lang]}</h2>
        <p>{t('home.selection')}</p>
      </header>
      <ul class="training-list" role="list">
        {trainings.map((training) => (
          <li class="training-card">
            <h3>{training.title}</h3>
            <div class="training-links">
              <a
                href={`${base}/${lang}/training/${training.path}/`}
                hreflang={lang}>
                {t('training-index.open')}
                <span aria-hidden="true">&nbsp;→</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      <div class="language-links">
        <a
          class="primary-action"
          href={`${base}/${lang}/training/`}
          hreflang={lang}>
          {t('home.trainings')}
        </a>
        <a href={`${base}/${lang}/`} hreflang={lang}>
          {t('home.slides')}
        </a>
      </div>
    </section>
  ))}
</Layout>

<script>
  import { getPreferredLang, useTranslations } from '../i18n/utils'
  import { translateDocument } from '../i18n/client'

  const lang = getPreferredLang(navigator.languages)
  const t = useTranslations(lang)
  translateDocument(lang, t('home.title'))
  const firstSection = document.querySelector('.language-section')
  const currentSection = document.querySelector(
    `.language-section[lang="${lang}"]`,
  )
  if (firstSection && currentSection) {
    firstSection.parentElement?.insertBefore(currentSection, firstSection)
  }
  const intro = document.querySelector('.page-intro')
  for (const [selector, key] of [
    ['.eyebrow', 'home.label'],
    ['h1', 'home.title'],
    ['p:last-child', 'home.description'],
  ] as const) {
    const element = intro?.querySelector(selector)
    if (element) element.textContent = t(key)
  }
</script>

<style>
  .language-section {
    margin-top: 3.5rem;
  }

  .language-header {
    border-top: 3px solid var(--as-control-border);
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .language-header h2 {
    margin: 0;
    font-size: 2rem;
  }

  .language-header p {
    margin: 0.5rem 0 0;
    color: var(--as-muted-text);
  }

  .training-card h3 {
    margin: 0 0 1.5rem;
    font-size: 1.4rem;
    line-height: 1.35;
  }

  .language-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 1.25rem;
    font-weight: 600;
  }

  .primary-action {
    display: inline-flex;
    padding: 0.85rem 1.25rem;
    border-radius: 0.7rem;
    background: var(--as-text);
    color: var(--as-background);
    text-decoration: none;
  }

  .primary-action:hover,
  .primary-action:focus-visible {
    background: var(--as-link);
    text-decoration: underline;
  }
</style>
