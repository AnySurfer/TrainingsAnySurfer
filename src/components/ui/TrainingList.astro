---
interface Props {
  lang?: 'fr' | 'nl' | 'en'
}

import { useTranslations } from '../../i18n/utils'

const { lang } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const trainings = [
  {
    slug: 'intro',
    fr: 'Introduction à l’accessibilité numérique',
    nl: 'Introductie digitale toegankelijkheid',
    en: 'Introduction to digital accessibility',
  },
  {
    slug: 'intro-modulair',
    nl: 'Digitale toegankelijkheid: de basis — modulair',
  },
  {
    slug: 'intro-eap',
    fr: 'Introduction à l’accessibilité numérique — EAP',
  },
  {
    slug: 'intro-court',
    fr: 'Introduction à l’accessibilité numérique — version courte',
  },
  {
    slug: 'pdf-intro',
    fr: "Introduction à l'accessibilité des documents PDF",
    nl: 'Introductie toegankelijke PDF documenten',
    en: 'Introduction to PDF accessibility',
  },
  {
    slug: 'pdf-testing',
    fr: "Tester l'accessibilité d'un document PDF",
    nl: 'PDF toegankelijkheid testen',
    en: 'Testing the accessibility of a PDF document',
  },
  {
    slug: 'acrobat',
    fr: 'Baliser un document PDF avec Acrobat Pro',
    nl: 'Toegankelijke PDF met Acrobat',
  },
  {
    slug: 'powerpdf',
    fr: 'PDF accessible avec Power PDF',
    nl: 'Toegankelijke PDF met Power PDF',
  },
  {
    slug: 'powerpdf-testing',
    fr: "Tester l'accessibilité d'un document PDF - Power PDF",
  },
  {
    slug: 'word',
    fr: 'Créer des documents accessibles avec Microsoft Word',
    nl: 'Toegankelijke documenten maken met Microsoft Word',
    en: 'Create accessible PDF documents with Microsoft Word',
  },
  {
    slug: 'indesign',
    fr: 'Créer des documents accessibles avec InDesign',
    nl: 'Toegankelijke PDF met InDesign',
  },
  {
    slug: 'dev',
    fr: 'Développer un site web accessible',
    nl: 'Toegankelijkheid voor front-end ontwikkelaars',
    en: 'Web accessibility for developers',
  },
  {
    slug: 'test',
    en: 'Web accessibility for testers',
  },
  {
    slug: 'design',
    fr: 'L’accessibilité pour les designers',
  },
  {
    slug: 'redac-bosa',
    fr: 'L’accessibilité web pour les rédacteurs - BOSA',
  },
  {
    slug: 'redac-eap',
    fr: 'Accessibilité web pour les rédacteurs — EAP',
  },
  {
    slug: 'redac-smals',
    fr: 'L’accessibilité web pour les rédacteurs - Smals',
  },
  {
    slug: 'redac',
    fr: 'Créer des contenus accessibles sur le web',
    nl: 'Toegankelijkheid voor webredacteurs',
  },
  {
    slug: 'editeur-texte',
    fr: 'Accessible avec un éditeur de texte',
  },
  {
    slug: 'toegankelijk-communiceren',
    nl: 'Toegankelijke communicatie',
  },
  {
    slug: 'video',
    fr: 'Accessibilité des vidéos',
    nl: 'Toegankelijkheid van multimedia',
  },
]
---

<ul class="training-list slide-catalog" role="list">
  {trainings
    .filter((training) => !lang || training[lang])
    .map((training) => (
      <li class="training-card">
        <h2 class="slide-title">
          {(['fr', 'nl', 'en'] as const)
            .filter((locale) => training[locale] && (!lang || lang === locale))
            .map((locale) => (
              <a
                class="slide-link"
                href={`${base}/${locale}/${training.slug}/`}
                lang={locale}
                hreflang={locale}>
                <span>{training[locale]}</span>
                <span class="slide-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))}
        </h2>
        <div class="training-links">
          {(['fr', 'nl', 'en'] as const)
            .filter((locale) => training[locale] && (!lang || lang === locale))
            .map((locale) => (
              <a
                class="syllabus-link"
                href={`${base}/${locale}/${training.slug}/syllabus/`}
                lang={locale}
                hreflang={locale}>
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8Z" />
                  <path d="M14 3v5h5M9 12h6M9 16h6" />
                </svg>
                {useTranslations(locale)('syllabus.link')}
              </a>
            ))}
        </div>
      </li>
    ))}
</ul>

<style>
  .slide-catalog .training-card {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    gap: 1.5rem;
    box-shadow: 0 3px 12px var(--as-control-shadow);
  }

  .training-card::before {
    content: '';
    width: 2rem;
    height: 0.25rem;
    border-radius: 1rem;
    background: #ffb721;
  }

  .training-card:hover,
  .training-card:focus-within {
    border-color: var(--as-link);
  }

  .slide-title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.35;
  }

  .slide-link {
    color: var(--as-text);
    text-decoration: none;
  }

  .slide-link:hover,
  .slide-link:focus-visible {
    color: var(--as-link);
    text-decoration: underline;
  }

  .slide-arrow {
    display: inline-block;
    margin-inline-start: 0.35em;
    color: var(--as-link);
    font-family: sans-serif;
    font-size: 1.1rem;
  }

  .syllabus-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--as-control-hover);
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .syllabus-link svg {
    flex-shrink: 0;
  }

  .syllabus-link:hover,
  .syllabus-link:focus-visible {
    text-decoration: underline;
  }
</style>
