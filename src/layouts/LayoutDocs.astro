---
import '@assets/css/global.css'
import '@assets/css/tokens.css'
import '@assets/css/documentation.css'
import type { Locale } from '../i18n/config'
import { docsLanguages, docsUi } from '../i18n/docs'

interface Props {
  title: string
  lang: Locale
  indexHref: string
  languageLinks: { lang: Locale; href?: string }[]
}
const { title, lang, indexHref, languageLinks } = Astro.props
const t = docsUi[lang]
---

<!doctype html>
<html lang={lang}>
  <UiHead title={`${title} — ${t.brand}`} />
  <body class="documentation">
    <a class="skip-link" href="#docs-content">
      {t.skip}
    </a>
    <header class="docs-header">
      <UiHeaderLogo lang={lang} />
      <!-- <a class="docs-home" href={indexHref}>
        {t.brand}
      </a> -->
      <div class="docs-languages">
        <ul>
          {docsLanguages.map(({ lang: targetLang, label }) => {
            const link = languageLinks.find((item) => item.lang === targetLang)
            return (
              <li>
                {link?.href ? (
                  <a
                    href={link.href}
                    lang={targetLang}
                    hreflang={targetLang}
                    aria-current={targetLang === lang ? 'page' : undefined}>
                    {label}
                  </a>
                ) : (
                  <span
                    lang={targetLang}
                    aria-disabled="true"
                    title={t.unavailable}>
                    {label}
                    <span class="visually-hidden"> — {t.unavailable}</span>
                  </span>
                )}
              </li>
            )
          })}
        </ul>
      </div>
    </header>
    <div class="docs-shell">
      <aside class="docs-sidebar">
        <p class="docs-label">{t.guides}</p>
        <slot name="navigation" />
      </aside>
      <main id="docs-content" class="docs-paper" tabindex="-1">
        <div class="docs-toolbar">
          <!-- <span class="docs-label">{t.documentation}</span> -->
        </div>
        <div class="docs-prose">
          <slot />
        </div>
        <div class="docs-pagination">
          <slot name="pagination" />
        </div>
      </main>
    </div>
    <UiFooter class="docs-footer" />
  </body>
</html>
