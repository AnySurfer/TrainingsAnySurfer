---
import Layout from '@layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const t = useTranslations('nl')
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="Nederlandstalige opleidingen" lang="nl">
  <div class="page-intro">
    <p class="eyebrow">De diavoorstellingen van AnySurfer</p>
    <h1>Nederlandstalige opleidingen</h1>
    <p>
      Bekijk het cursusmateriaal van onze opleidingen over digitale
      toegankelijkheid.
    </p>
    <p>
      <a href={`${base}/nl/training/`}>{t('training-index.link')}</a>
    </p>
  </div>
  <UiTrainingList lang="nl" />
</Layout>
