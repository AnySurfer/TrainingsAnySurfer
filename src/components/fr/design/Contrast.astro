  <section>
    <h1>Contrastes</h1>
  </section>
  <section>
    <h2>Contraste du texte</h2>
    <ul>
      <li>minimum 4,5:1 pour le texte normal</li>
      <li>minimum 3:1 pour les grands textes (> 24 px ou > 18 px et gras)</li>
    </ul>
  </section>
  <section>
