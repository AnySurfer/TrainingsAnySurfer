---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'

const title = 'Create accessible PDF documents with Microsoft Word'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!-- Source: Input/reveal/word_en.html -->
<LayoutSyllabus title={title} lang="en" slidesHref={`${base}/en/word/`}>
  <EnWordIntroduction />
  <EnWordLanguage />
  <EnWordDocumentTitle />
  <EnWordReadability />
  <EnWordHeadings />
  <EnWordLists />
  <EnWordImages />
  <EnWordAccessibilityCheck />
  <EnWordPdfExport />
  <EnWordLinks />
  <EnWordBuiltInFeatures />
  <EnWordTables />
  <EnWordReadingOrder />
  <EnWordColor />
  <EnWordPdfTesting />
  <EnWordTemplates />
</LayoutSyllabus>
