    <p>Prévoir un bouton "pause"</p>
  </section>

  <!-- Mises à jour automatiques -->
  <section>
    <h2>Contrôles sur les mises à jour automatiques</h2>
    <a href="http://www.lesoir.be/filinfo/popup" class="image-link">
      <img
        class="stretch"
        src="http://images.anysurfer.be/perturbations/lesoir_filinfo.png"
