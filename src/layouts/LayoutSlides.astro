---
import 'reveal.js/reveal.css'
import 'reveal.js/theme/simple.css'
import '@assets/css/tokens.css'
import '@assets/css/global.css'
import '@assets/css/slides.css'
import '@assets/css/wave-background.css'
import '@assets/css/slide-navigation.css'
import '@assets/css/slide-layouts.css'
import '@assets/css/zenburn.css'

import { defaultLang, type Locale } from '../i18n/config'

interface Props {
  title: string
  lang?: Locale
}

const {
  title = 'Slides - Anysurfer',
  lang = Astro.currentLocale ?? defaultLang,
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <UiHead title={title} />
  <body>
    <div class="as-wave-background">
      <span class="as-wave-background__top"></span>
      <span class="as-wave-background__bottom"></span>
      <span class="as-wave-background__sun"></span>
    </div>
    <UiDeck>
      <slot />
    </UiDeck>
  </body>
</html>

<script>
  import Reveal, { type TransitionStyle, type TransitionSpeed } from 'reveal.js'
  import highlight from 'reveal.js/plugin/highlight'
  import notes from 'reveal.js/plugin/notes'
  import initAnySurferWave from '@assets/script/anysurfer-wave.ts'

  /* AnySurfer CONSTANTS */
  const AS_TRANSITION: TransitionStyle = 'none'
  const AS_TRANSITION_SPEED: TransitionSpeed = 'fast'

  /* Handle reduced motion */
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
  const isReducedMotion = mediaQuery.matches
  const handleMotionPreference = (e: MediaQueryListEvent) => {
    deck.configure({
      transition: mediaQuery.matches ? 'none' : AS_TRANSITION,
    })
  }
  mediaQuery.addEventListener('change', handleMotionPreference)

  /* Init Reveal.js */
  const deck = new Reveal({
    plugins: [highlight, notes],
  })

  const keyboard = {
    74: 'left',
    75: 'up',
    76: 'down',
    77: 'right',
  }
  deck
    .initialize({
      center: true,
      controls: false, // custom controls
      history: true,
      keyboard,
      progress: true,
      transition: isReducedMotion ? 'none' : AS_TRANSITION,
      transitionSpeed: AS_TRANSITION_SPEED,
      autoAnimate: false,
    })
    .then(() => {
      initAnySurferWave(deck)
    })
</script>
