---
import Layout from '@layouts/LayoutSlides.astro'

const title = 'Formation Rédacteurs - AnySurfer'
---

<!-- Source : Input/reveal/redac_fr_BOSA.html -->
<Layout title={title}>
    <section>
        <FrSharedInstructions />
	    <FrSharedLogo />
        <FrSharedTitle title="Accessibilité web pour les rédacteurs" />

        <section>
            <h2>Plan</h2>
            <ol>
                <li>Introduction générale
                    <ul>
                        <li>Accessibilité</li>
                        <li>Personas</li>
                        <li>Standards et lois</li>
                    </ul>
                </li>
                <li>Bonnes pratiques et exercices</li>
            </ol>
        </section>

        <section>
            <h2>Bonnes pratiques</h2>
            <ol>
                <li>Donnez à chaque page un titre significatif</li>
                <li>Donnez des intitulés pertinents aux liens</li>
                <li>Utilisez bien les titres et les listes</li>
                <li>Donnez une bonne alternative textuelle aux images</li>
                <li>N'utilisez pas uniquement la couleur pour transmettre l'information</li>
                <li>Structurez correctement les tableaux</li>
                <li>Prévoyez des alternatives pour les contenus audio et vidéo</li>
                <li>N'oubliez pas l'accessibilité des documents</li>
            </ol>
        </section>
    </section>

    <FrIntroAccessibility />
    <FrIntroWho />
    <FrIntroPersonas />
    <FrPersonasNina />
    <FrPersonasJerry />
    <FrPersonasJim />
    <FrPersonasCecile />
    <FrPersonasKadisha />
    <FrPersonasDavid />
    <FrPersonasTommy />
    <FrPersonasVera />
    <FrPersonasKarolijn />
    <FrPersonasPhilippe />
    <FrIntroAvatars />
    <FrIntroLaw />
    <FrIntroStandard />

    <FrRedacIntroduction />
    <FrRedacPageTitles />
    <FrRedacLinks />
    <FrRedacTextStructure />
    <FrRedacImages />
    <FrRedacColor />
    <FrRedacTables />
    <FrRedacVideoAudio />
    <FrRedacDocuments />
    <FrRedacConclusion />
</Layout>
