<section id="word-readability">
					<section>
						<h1>Readability</h1>
					</section>

					<section>
						<h2>Advice</h2>
						<ul>
							<li>Readable font</li>
							<li>Not too many different fonts</li>
							<li>Align text left (don't justify)</li>
							<li>Avoid italics, cursive</li>
							<li>Sufficient contrast </li>
							<li>Sufficient line spacing (1,5)</li>
							<li>Sufficient text size </li>
						</ul>
						<p>Follow organisation style guide if there is one</p>
					</section>

					<section>
						<h2>Font</h2>
						<img src="https://images.anysurfer.be/readability/lisibilite_3polices.png" alt="même texte dans 3 polices : 1 sans sérif simple, 1 italique et une police en capitales">

					</section>
					<section>
						<ul>
							<li>Prefer sober font</li>
							<li>Avoid cursive</li>
							<li>Avoid writing in all caps</li>
							<li>Text size, number of characters per line, and line spacing also influence readability. </li>
						</ul>

					</section>

					<section>
						<h2>Contrast</h2>
						<ul>
							<li>Contrast at least 4,5 between text and background</li>
							<li>Use Word accessibility checker to check contrast</li>
						</ul>
					</section>

					<section>
						<h2>Try it yourself</h2>
						<ol>
							<li>Start from a food recipe</li>
							<li>Create a new Word document</li>
							<li>Add the text of the recipe</li>
							<li>Define the language of the document</li>
							<li>Define the title of the document</li>
							<li>Define the style 'Normal' : Choose a font, a font size and a text color with readability in mind</li>
							<li>Save the result</li>
						</ol>
					</section>

				</section>
