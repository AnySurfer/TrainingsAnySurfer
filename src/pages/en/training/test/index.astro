---
import Layout from '@layouts/Layout.astro'
import resources from '@data/test-en-training-resources.json'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const sections = [
  {
    id: 'references',
    title: 'Useful resources',
    number: '02',
    links: resources.references,
  },
]
---

<!-- Source : https://training.anysurfer.be/en/test/ -->
<Layout title="Web accessibility for testers" lang="en">
  <header class="resource-intro">
    <p class="eyebrow">AnySurfer training · Resources</p>
    <h1>
      Web accessibility
      <br />
      <span>For testers</span>
    </h1>
    <nav class="section-navigation" aria-label="On this page">
      <ul role="list">
        <li>
          <a href="#slides">Slides</a>
        </li>
        {sections.map(({ id, title }) => (
          <li>
            <a href={`#${id}`}>{title}</a>
          </li>
        ))}
        <li>
          <a href="#tools">Tools</a>
        </li>
        <li>
          <a href="#exercises">Exercises</a>
        </li>
      </ul>
    </nav>
  </header>

  <div class="resource-grid">
    <section class="resource-card slides-card" aria-labelledby="slides">
      <span class="section-number" aria-hidden="true">
        01
      </span>
      <h2 id="slides">Slides</h2>
      <h3>Module 1</h3>
      <a class="slide-link" href={`${base}/en/intro`}>
        Introduction <span aria-hidden="true">→</span>
      </a>
      <h3 class="next-module">Modules 2 and 3</h3>
      <a class="slide-link" href={`${base}/en/test`}>
        Web accessibility for testers <span aria-hidden="true">→</span>
      </a>
    </section>
    {sections.map(({ id, title, number, links }) => (
      <section class="resource-card" aria-labelledby={id}>
        <span class="section-number" aria-hidden="true">
          {number}
        </span>
        <h2 id={id}>{title}</h2>
        <ul class="resource-links" role="list">
          {links.map((link) => (
            <li>
              <a href={link.href} lang={'lang' in link ? link.lang : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="resource-card tools-card" aria-labelledby="tools">
    <header class="tools-header">
      <span class="section-number" aria-hidden="true">
        03
      </span>
      <h2 id="tools">Tools</h2>
    </header>
    <div class="tools-grid">
      <div>
        <h3>Applications and plugins</h3>
        <ul class="resource-links" role="list">
          {resources.applications.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="bookmarks">
        <h3>Bookmarklets</h3>
        <p class="bookmark-help">
          Drag the bookmarklets to your bookmarks bar, then use them on the page
          you want to check. The first two links open the tools and their
          instructions.
        </p>
        <ul class="bookmark-list" role="list">
          {resources.bookmarks.map((link) => (
            <li>
              <a href={link.href} lang={'lang' in link ? link.lang : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="resource-card exercises-card" aria-labelledby="exercises">
    <span class="section-number" aria-hidden="true">
      04
    </span>
    <h2 id="exercises">Exercises</h2>
    <EnTrainingTestExercises />
  </section>
</Layout>

<style>
  .exercises-card {
    margin-top: 1.5rem;
  }
  .next-module {
    margin-top: 2rem;
  }

  .resource-intro {
    margin-bottom: 2.5rem;
  }
  h1 {
    max-width: 60rem;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  }
  h1 span {
    color: var(--as-link);
  }
  .section-navigation {
    margin-top: 2rem;
  }
  .section-navigation ul {
    gap: 0.75rem;
  }
  .section-navigation a {
    border: 1px solid var(--as-control-border);
    background: var(--as-control-background);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
  }
  .resource-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .resource-card {
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--as-control-border);
    border-radius: 1.25rem;
    background: var(--as-control-background);
  }
  .slides-card {
    background: var(--as-control-hover);
  }
  .section-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--as-control-border);
    border-radius: 50%;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--as-muted-text);
  }
  h2 {
    margin: 0.75rem 0 1.5rem;
    font-size: 2.25rem;
    line-height: 1.2;
    scroll-margin-top: 1.5rem;
  }
  h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    line-height: 1.4;
  }
  .slide-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 1.3rem;
    font-weight: 600;
  }
  .resource-links,
  .bookmark-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .resource-links a {
    display: block;
    padding-block: 0.65rem;
    overflow-wrap: anywhere;
  }
  .resource-links li + li {
    border-top: 1px solid var(--as-control-border);
  }
  .tools-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .tools-header h2 {
    margin: 0;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2.5rem;
  }
  .bookmarks {
    border-left: 1px solid var(--as-control-border);
    padding-left: 2.5rem;
  }
  .bookmark-help {
    margin: 0 0 1.5rem;
    color: var(--as-muted-text);
    font-size: 1rem;
  }
  .bookmark-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .bookmark-list a {
    display: block;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--as-control-border);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
  }
  .bookmark-list a:hover {
    background: var(--as-control-hover);
  }
  @media (max-width: 800px) {
    .resource-grid,
    .tools-grid {
      grid-template-columns: 1fr;
    }
    .bookmarks {
      border-left: 0;
      border-top: 1px solid var(--as-control-border);
      padding: 1.5rem 0 0;
    }
    .tools-grid {
      gap: 1.5rem;
    }
  }
</style>
