---
import Layout from '@layouts/Layout.astro'
import {
  parseTrainingResources,
  resourceHref,
} from '../../utils/training-resources'

/**
 * Complete resources page with navigation and numbering derived from JSON sections.
 * @param {unknown} training - Resource data validated against the shared schema.
 * @slot heading - Optional page heading, including its h1.
 * @slot [name] - Custom Astro content referenced by a group's slot field.
 * @example <UiTrainingResources training={training} />
 */
interface Props {
  training: unknown
}

const sharedFiles = Object.fromEntries(
  Object.entries(
    import.meta.glob('../../data/*training-resources.json', {
      eager: true,
      import: 'default',
    }),
  ).map(([path, data]) => [path.split('/').pop()!, data]),
)
const training = parseTrainingResources(Astro.props.training, sharedFiles)
const base = import.meta.env.BASE_URL
for (const section of training.sections) {
  for (const group of section.groups) {
    if (group.slot && !Astro.slots.has(group.slot)) {
      throw new Error(
        `${training.title}: missing resource slot "${group.slot}"`,
      )
    }
  }
}
---

<Layout title={training.title} lang={training.lang}>
  <header class="resource-intro">
    <p class="eyebrow">{training.eyebrow}</p>
    <slot name="heading">
      <h1>{training.title}</h1>
    </slot>
    {training.sections.length > 0 && (
      <nav class="section-navigation" aria-label={training.navigationLabel}>
        <ul role="list">
          {training.sections.map(({ id, title, navigationTitle }) => (
            <li>
              <a href={`#${id}`}>{navigationTitle ?? title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>
  <div class="resource-grid">
    {training.sections.map((section, index) => (
      <section
        class:list={[
          'resource-card',
          {
            'slides-card': section.type === 'slides',
            'full-width': section.fullWidth,
          },
        ]}
        aria-labelledby={section.id}>
        <header class="resource-heading">
          <span class="section-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h2 id={section.id}>{section.title}</h2>
        </header>
        <div
          class:list={[
            'resource-groups',
            { 'group-columns': section.columns },
          ]}>
          {section.groups.map((group) => {
            const List = group.ordered ? 'ol' : 'ul'
            return (
              <div class="resource-group">
                {group.title && <h3>{group.title}</h3>}
                {group.paragraphs.map((paragraph) => (
                  <p
                    class:list={{
                      'bookmark-help': group.type === 'bookmarks',
                    }}>
                    {paragraph}
                  </p>
                ))}
                {group.links.length > 0 && (
                  <ul
                    class:list={[
                      'resource-links',
                      {
                        'bookmark-list': group.type === 'bookmarks',
                        'slide-links': group.type === 'slides',
                        'ordered-links': group.ordered,
                      },
                    ]}
                    role="list">
                    {group.links.map((link) => (
                      <li>
                        <a
                          href={resourceHref(link.href, base)}
                          lang={link.lang}
                          hreflang={link.hreflang}
                          target={link.target}
                          rel={
                            link.rel ??
                            (link.target === '_blank'
                              ? 'noopener noreferrer'
                              : undefined)
                          }
                          download={link.download}>
                          <span>
                            {link.subtitle && (
                              <small class="link-subtitle">
                                {link.subtitle}
                              </small>
                            )}
                            {link.label}
                          </span>
                          {group.type === 'slides' && (
                            <span aria-hidden="true">→</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {group.slot && <slot name={group.slot} />}
              </div>
            )
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>
