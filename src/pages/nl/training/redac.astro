---
import training from '@data/redac-nl-training-resources.json'
---

<UiTrainingResources training={training}>
  <Fragment slot="heading">
    <h1>
      Webtoegankelijkheid
      <br />
      <span>voor redacteurs</span>
    </h1>
  </Fragment>
  <Fragment slot="slides-content-1">
    <ul class="slide-instructions">
      <li>Druk escape voor een overzicht van alle slides.</li>
      <li>
        Gebruik de pijltjestoetsen om horizontaal of verticaal tussen de slides
        te navigeren.
      </li>
      <li>Of gebruik de knoppen rechtsonder.</li>
    </ul>
  </Fragment>
  <Fragment slot="exercises-content-2">
    <dl class="exercise-details">
      <div>
        <dt>Inloggen</dt>
        <dd>
          <a href="https://demo.anysurfer.be/wp-login.php">
            https://demo.anysurfer.be/wp-login.php
          </a>
        </dd>
      </div>
      <div>
        <dt>Gebruikersnaam</dt>
        <dd>
          <code>gebruiker1</code>
        </dd>
      </div>
      <div>
        <dt>Bekijk het resultaat</dt>
        <dd>
          <a href="https://demo.anysurfer.be/nl/">
            https://demo.anysurfer.be/nl/
          </a>
        </dd>
      </div>
    </dl>
  </Fragment>
  <Fragment slot="evaluation-content-4">
    <p>
      Opleidingsnummer: <strong>887</strong>
    </p>
  </Fragment>
</UiTrainingResources>
