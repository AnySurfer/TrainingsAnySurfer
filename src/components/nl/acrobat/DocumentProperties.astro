<section id="properties">
    <section>
        <h1>Document eigenschappen</h1>
    </section>

    <section>
        <p>Ctrl+D om documenteigenschappen dialoogvenster te openen</p>
        <ul>
            <li>In "Beschrijving" tab: vul titel in</li>
            <li>In "Beschrijving" tab: Check dat "gecodeerde PDF" op "Ja" staat</li>
            <li>In "Weergave bij openen" tab : selecteer "Documenttitel"</li>
            <li>In "Geavanceerd" tab : selecteer juiste taal</li>
        </ul>
    </section>

    <section>
        <img src="https://images.anysurfer.be/applications/AcrobatXI/doc_properties_acrobat_nl.png" class="stretch" alt="documenteigenschappen beschrijving tab : vul titel in" />
    </section>

    <section>
        <img src="https://images.anysurfer.be/applications/AcrobatXI/doc_properties_initial_view_nl.png" class="stretch" alt="documenteigenschappen Weergave bij openen tab : selecteer documenttitel" />
    </section>

    <section>
        <img src="https://images.anysurfer.be/applications/AcrobatXI/doc_properties_advanced_nl.png" class="stretch" alt="documenteigenschappen geavanceerd tab voor taal" />
    </section>
</section>
