---
/**
 * Table of contents linking to chapter anchors; renders nothing when the list is empty.
 * @param {string} title - Table of contents heading, rendered as an h2.
 * @param {{ id: string, title: string }[]} chapters - Existing chapter anchors and their labels.
 * @remarks Use once per page: the heading has the fixed id syllabus-toc-title.
 * @example <UiTableOfContents title="Contents" chapters={[{ id: 'intro', title: 'Introduction' }]} />
 */
interface Props {
  title: string
  chapters: { id: string; title: string }[]
}

const { title, chapters } = Astro.props
---

{chapters.length > 0 && (
  <nav class="syllabus-toc" aria-labelledby="syllabus-toc-title">
    <h2 id="syllabus-toc-title">{title}</h2>
    <ol>
      {chapters.map((chapter) => (
        <li>
          <a href={`#${chapter.id}`}>{chapter.title}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
