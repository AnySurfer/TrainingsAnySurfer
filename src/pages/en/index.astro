---
import Layout from '@layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const t = useTranslations('en')
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="English training courses" lang="en">
  <div class="page-intro">
    <p class="eyebrow">AnySurfer slides</p>
    <h1>English training courses</h1>
    <p>Explore our training slides on digital accessibility.</p>
    <p>
      <a href={`${base}/en/training/`}>{t('training-index.link')}</a>
    </p>
  </div>
  <UiTrainingList lang="en" />
</Layout>
