---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'

const title = 'Créer des documents accessibles avec Acrobat'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<LayoutSyllabus title={title} lang="fr" slidesHref={`${base}/fr/acrobat/`}>
  <!-- Introduction -->

  <FrAcrobatIntro />
  <FrAcrobatTags />
  <FrAcrobatAcrobat />
  <FrAcrobatRoot />
  <FrAcrobatMethodOne />
  <FrAcrobatMethodTwo />
  <FrAcrobatImage />
  <FrAcrobatTips />
  <FrAcrobatMetadata />
</LayoutSyllabus>
