---
import '@assets/css/global.css'
import '@assets/css/theme/anysurfer-wave.css'
import '@assets/css/training-resources.css'

import { i18n, defaultLang, type Locale } from '../i18n/config'
import HeaderLogo from '@components/ui/HeaderLogo.astro'
import Footer from '@components/ui/Footer.astro'
import { getAriaCurrent } from '../utils/navigation'
import { languages } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import Head from '@components/ui/Head.astro'

interface Props {
  title: string
  lang?: Locale
}

const { title, lang: requestedLang } = Astro.props
const lang =
  i18n.locales.find(
    (locale) => locale === (requestedLang ?? Astro.currentLocale),
  ) ?? defaultLang
const t = useTranslations(lang)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = `${base}/`
const navigation = [
  {
    href: home,
    label: t('navigation.home'),
    lang,
    sectionPath: undefined,
  },
  {
    href: `${base}/fr/training/`,
    label: languages.fr,
    lang: 'fr',
    sectionPath: `${base}/fr`,
  },
  {
    href: `${base}/nl/training/`,
    label: languages.nl,
    lang: 'nl',
    sectionPath: `${base}/nl`,
  },
  {
    href: `${base}/en/training/`,
    label: languages.en,
    lang: 'en',
    sectionPath: `${base}/en`,
  },
]
---

<!doctype html>
<html lang={lang}>
  <Head title={title} />
  <body>
    <a class="skip-link" href="#main">
      {t('navigation.skip')}
    </a>
    <header class="site-header">
      <HeaderLogo lang={lang} />
      <nav class="site-navigation" aria-label={t('navigation.label')}>
        <ul role="list">
          {navigation.map((item) => (
            <li class:list={{ 'home-item': item.href === home }}>
              <a
                class:list={{ 'home-link': item.href === home }}
                href={item.href}
                lang={item.lang}
                aria-label={item.href === home ? item.label : undefined}
                title={item.href === home ? item.label : undefined}
                data-section-path={item.sectionPath}
                aria-current={getAriaCurrent(
                  Astro.url.pathname,
                  item.href,
                  item.sectionPath,
                )}>
                {item.href === home ? (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false">
                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" />
                  </svg>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="as-wave-background" aria-hidden="true">
      <span class="as-wave-background__top"></span>
      <span class="as-wave-background__bottom"></span>
      <span class="as-wave-background__sun"></span>
    </div>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css?family=News+Cycle:400,700');

  * {
    box-sizing: border-box;
  }
  html {
    color: var(--as-text);
  }
  body {
    margin: 0;
    min-height: 100vh;
    font-family:
      proxima-nova,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
    isolation: isolate;
  }
  a {
    color: var(--as-link);
    text-underline-offset: 0.2em;
  }
  a:hover {
    text-decoration-thickness: 0.15em;
  }
  a:focus-visible {
    outline: 3px solid var(--as-focus);
    outline-offset: 5px;
  }
  .site-header,
  .site-footer,
  main {
    position: relative;
    z-index: 2;
    width: min(72rem, calc(100% - 4rem));
    margin-inline: auto;
  }
  .site-footer {
    border-top: 2px solid var(--as-link);
    padding-block: 1rem 2rem;
    font-size: 0.9rem;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }
  .brand {
    display: inline-flex;
    max-width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    background: #fffdf8;
  }
  .brand img {
    display: block;
    width: 17rem;
    max-width: 100%;
    height: auto;
  }
  .site-navigation {
    padding: 0.375rem;
    border: 1px solid var(--as-control-border);
    border-radius: 1rem;
    background: var(--as-control-background);
    box-shadow: var(--as-elevation-1);
  }
  .site-navigation ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-navigation a {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 0.7rem;
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--as-transition-hover),
      color var(--as-transition-hover);
  }
  .site-navigation a:hover {
    background: var(--as-control-hover);
    text-decoration: underline;
  }
  .site-navigation .home-item {
    flex: 0 0 auto;
  }
  .site-navigation .home-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 100%;
    min-height: 2.75rem;
    padding: 0.65rem;
  }
  .site-navigation a[aria-current] {
    background: var(--as-text);
    color: var(--as-control-background);
    box-shadow: inset 0 -3px 0 #ffb721;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-navigation a {
      transition: none;
    }
  }
  main {
    padding-block: 2rem 7rem;
  }
  .page-intro {
    max-width: 52rem;
    margin-bottom: 3rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--as-muted-text);
    font-weight: 600;
  }
  h1,
  h2 {
    font-family: 'News Cycle', sans-serif;
    font-weight: 700;
    text-wrap: balance;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
  }
  .page-intro > p:last-child {
    margin: 1.25rem 0 0;
    color: var(--as-muted-text);
  }
  .training-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .training-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--as-control-border);
    border-radius: 1rem;
    background: var(--as-control-background);
  }

  @media screen and (prefers-reduced-transparency: no-preference) {
    .training-card {
      background: color-mix(
        in srgb,
        var(--as-control-background) 75%,
        transparent
      );
      -webkit-backdrop-filter: blur(5px);
      backdrop-filter: blur(5px);
    }
  }

  .training-card h2 {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
    line-height: 1.3;
  }
  .training-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
  }
  .training-links a {
    font-weight: 600;
  }
  .as-wave-background {
    position: fixed;
  }

  @media (max-width: 640px) {
    .site-navigation {
      width: 100%;
    }
    .site-navigation li {
      flex: 1 1 auto;
    }
    .site-header,
    .site-footer,
    main {
      width: calc(100% - 2rem);
    }
    .site-header {
      padding-block: 1.5rem;
    }
    main {
      padding-top: 1.5rem;
    }
    .training-list {
      grid-template-columns: 1fr;
    }
  }
</style>
