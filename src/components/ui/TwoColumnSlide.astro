---
import type { HTMLAttributes } from 'astro/types'

/**
 * Diapositive Reveal.js complète, avec sa section et deux colonnes égales, centrées verticalement.
 * @param {string} [title] - Titre affiché dans un h2 s’il est non vide.
 * @slot left - Contenu de la colonne gauche.
 * @slot right - Contenu de la colonne droite.
 * @slot notes - Notes de présentation, généralement un UiNote.
 * @remarks Aucun slot par défaut ; les autres attributs HTML ne sont pas transmis.
 * @example <UiTwoColumnSlide title="Comparer"><p slot="left">Avant</p><p slot="right">Après</p></UiTwoColumnSlide>
 */

interface Props extends HTMLAttributes<'section'> {
  title?: string
}

const { title } = Astro.props
---

<section class="two-column-slide">
  <div class="slide-layout">
    {title && <h2>{title}</h2>}
    <div class="slide-columns">
      <div class="slide-column">
        <slot name="left" />
      </div>
      <div class="slide-column">
        <slot name="right" />
      </div>
    </div>
  </div>
  <slot name="notes" />
</section>

<style is:global>
  .reveal .slides .two-column-slide {
    height: 100%;
    padding: 0;
  }

  .slide-layout {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.5em;
    height: 100%;
  }

  .slide-layout > h2 {
    margin: 0;
  }

  .slide-columns {
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 1.5em;
  }
</style>
