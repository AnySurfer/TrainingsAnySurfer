---
import Layout from '@layouts/Layout.astro'
import { defaultLang, ui } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import LogoFR from '@assets/img/logo/logo_AS_baseline_fr.png'
import LogoNL from '@assets/img/logo/logo_AS_baseline_nl.png'
import LogoEN from '@assets/img/logo/logo_AS_baseline_en.png'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const locale = Astro.currentLocale ?? defaultLang
const lang = Object.hasOwn(ui, locale)
  ? (locale as keyof typeof ui)
  : defaultLang
const t = useTranslations(lang)
const logos = { fr: LogoFR, nl: LogoNL, en: LogoEN }
---

<Layout title={t('error-404.title')} lang={lang}>
  <div class="error-page" data-logos={JSON.stringify(logos)}>
    <p class="error-code" aria-hidden="true">
      404
    </p>
    <div class="page-intro">
      <p class="eyebrow">{t('error-404.label')}</p>
      <h1>{t('error-404.title')}</h1>
      <p>{t('error-404.description')}</p>
    </div>
    <a class="home-link" href={`${base}/${lang}/training/`}>
      {t('error-404.home')}
    </a>
  </div>
</Layout>

<script>
  import { getLangFromUrl, useTranslations } from '../i18n/utils'

  // GitHub Pages serves the same static 404.html for every missing URL.
  const lang = getLangFromUrl(
    new URL(window.location.href),
    import.meta.env.BASE_URL,
  )
  const t = useTranslations(lang)
  document.documentElement.lang = lang
  document.title = `${t('error-404.title')} — AnySurfer`
  const updateText = (selector: string, text: string) => {
    const element = document.querySelector(selector)
    if (element) element.textContent = text
  }
  updateText('.error-page .eyebrow', t('error-404.label'))
  updateText('.error-page h1', t('error-404.title'))
  updateText(
    '.error-page .page-intro > p:last-child',
    t('error-404.description'),
  )
  updateText('.error-page .home-link', t('error-404.home'))
  const recoveryLink = document.querySelector<HTMLAnchorElement>(
    '.error-page .home-link',
  )
  if (recoveryLink) {
    recoveryLink.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${lang}/training/`
  }
  updateText(
    '.skip-link',
    { fr: 'Aller au contenu', nl: 'Naar de inhoud', en: 'Skip to content' }[
      lang
    ],
  )
  const nav = document.querySelector('.site-header nav')
  nav?.setAttribute(
    'aria-label',
    {
      fr: 'Formations et langues',
      nl: 'Opleidingen en talen',
      en: 'Training courses and languages',
    }[lang],
  )
  const home = nav?.querySelector('a')
  if (home) {
    home.textContent = { fr: 'Accueil', nl: 'Startpagina', en: 'Home' }[lang]
    home.lang = lang
  }
  const logo = document.querySelector<HTMLImageElement>('.brand img')
  const logoData =
    document.querySelector<HTMLElement>('.error-page')?.dataset.logos
  if (logo && logoData) {
    const images = JSON.parse(logoData)
    logo.src = images[lang].src
    logo.width = images[lang].width
    logo.height = images[lang].height
    logo.alt = {
      fr: 'AnySurfer — pour un Internet plus accessible',
      nl: 'AnySurfer — voor een toegankelijker internet',
      en: 'AnySurfer — towards an accessible internet',
    }[lang]
  }
  const brand = document.querySelector<HTMLAnchorElement>('.brand')
  if (brand)
    brand.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${lang}/training/`
</script>

<style>
  .error-page {
    max-width: 52rem;
    padding-block: 1rem 3rem;
  }

  .error-code {
    margin: 0 0 1.5rem;
    color: var(--as-text);
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .error-code::after {
    content: '';
    display: block;
    width: 4rem;
    height: 0.4rem;
    margin-top: 1rem;
    border-radius: 1rem;
    background: #ffb721;
  }

  .home-link {
    display: inline-block;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--as-control-border);
    border-radius: 0.7rem;
    background: var(--as-control-background);
    font-weight: 600;
  }

  .home-link:hover {
    background: var(--as-control-hover);
  }
</style>
