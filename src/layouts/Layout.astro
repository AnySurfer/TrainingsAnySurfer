---
import '@assets/css/global.css'
import '@assets/css/tokens.css'
import '@assets/css/wave-background.css'
import '@assets/css/site.css'
import '@assets/css/training-resources.css'

import { i18n, defaultLang, type Locale } from '../i18n/config'
import { getAriaCurrent } from '../utils/navigation'
import { languages } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'

interface Props {
  title: string
  lang?: Locale
}

const { title, lang: requestedLang } = Astro.props
const lang =
  i18n.locales.find(
    (locale) => locale === (requestedLang ?? Astro.currentLocale),
  ) ?? defaultLang
const t = useTranslations(lang)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = `${base}/`
const navigation = [
  {
    href: home,
    label: t('navigation.home'),
    lang,
    sectionPath: undefined,
  },
  {
    href: `${base}/fr/training/`,
    label: languages.fr,
    lang: 'fr',
    sectionPath: `${base}/fr`,
  },
  {
    href: `${base}/nl/training/`,
    label: languages.nl,
    lang: 'nl',
    sectionPath: `${base}/nl`,
  },
  {
    href: `${base}/en/training/`,
    label: languages.en,
    lang: 'en',
    sectionPath: `${base}/en`,
  },
]
---

<!doctype html>
<html lang={lang}>
  <UiHead title={title} />
  <body>
    <a class="skip-link" href="#main">
      {t('navigation.skip')}
    </a>
    <header class="site-header">
      <UiHeaderLogo lang={lang} />
      <nav class="site-navigation" aria-label={t('navigation.label')}>
        <ul role="list">
          {navigation.map((item) => (
            <li class:list={{ 'home-item': item.href === home }}>
              <a
                class:list={{ 'home-link': item.href === home }}
                href={item.href}
                lang={item.lang}
                aria-label={item.href === home ? item.label : undefined}
                title={item.href === home ? item.label : undefined}
                data-section-path={item.sectionPath}
                aria-current={getAriaCurrent(
                  Astro.url.pathname,
                  item.href,
                  item.sectionPath,
                )}>
                {item.href === home ? (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false">
                    <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" />
                  </svg>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <UiFooter />
    <div class="as-wave-background" aria-hidden="true">
      <span class="as-wave-background__top"></span>
      <span class="as-wave-background__bottom"></span>
      <span class="as-wave-background__sun"></span>
    </div>
  </body>
</html>
