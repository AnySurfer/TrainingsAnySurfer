---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'
import InDesignLogo from '@assets/img/indesign/indesign_logo.png'

const title = 'Toegankelijke PDF met InDesign'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!-- Source : Input/pdf/indesign.html -->
<LayoutSyllabus title={title} lang="nl" slidesHref={`${base}/nl/indesign/`}>
  <section id="indesign-logo">
    <img src={InDesignLogo.src} class="stretch" alt="Logo InDesign" />
  </section>
  <NlIndesignSteps />
  <NlIndesignReadability />
  <NlIndesignLanguage />
  <NlIndesignParagraphStyles />
  <NlIndesignAlternativeText />
  <NlIndesignReadingOrder />
  <NlIndesignReflowOrder />
  <NlIndesignDocumentTitle />
  <NlIndesignPdfExport />
</LayoutSyllabus>
