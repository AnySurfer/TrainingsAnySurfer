{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", ".astro/auto-imports.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@layouts/*": ["./src/layouts/*"]
    }
  }
}
