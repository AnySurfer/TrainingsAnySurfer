---
import Layout from '@layouts/LayoutSlides.astro'

const title = 'Webtoegankelijkheid voor designers'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<style>
    	 ol.stappen {
			display: flex;
			justify-content: center;
			gap: 2.2em;
			margin: 0.6em 0 0 0;
			list-style: none;
			counter-reset: stap;
	}
	 ol.stappen li {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 7.5em;
			padding: 1.2em 0.6em 0.7em 0.6em;
			border-top: 6px solid #006EB2;
			border-radius: 8px;
			background: #f0f5f9;
			font-size: 0.8em;
			line-height: 1.25;
			text-align: center;
			counter-increment: stap;
	}
	 ol.stappen li::before {
			content: counter(stap);
			position: absolute;
			top: -0.9em;
			width: 1.6em;
			height: 1.6em;
			border-radius: 50%;
			background: #006EB2;
			color: #fff;
			font-weight: bold;
			line-height: 1.6em;
	}
	 ol.stappen li span {
			margin-top: 0.3em;
			color: #404040;
			font-size: 0.85em;
	}
	 ol.stappen li:not(:last-child)::after {
			content: "";
			position: absolute;
			/* midden van de tussenruimte: (2.2em gap / 0.8em fontgrootte) / 2 + halve pijlbreedte */
			right: -1.825em;
			top: 50%;
			margin-top: -0.5em;
			border: 0.5em solid transparent;
			border-right: 0;
			border-left: 0.9em solid #006EB2;
	}
	 .stappen-lus {
			display: block;
			margin: 0.5em auto 0 auto;
			color: #006EB2;
	}
	 p.stappen-lus-tekst {
			margin-top: 0.4em;
			color: #006EB2;
			font-size: 0.8em;
			font-weight: bold;
	}
	 .secties {
			display: flex;
			justify-content: center;
			gap: 1.4em;
	}
	 .secties img {
			height: 480px;
			margin: 0;
			border: 0;
			box-shadow: none;
	}
	/* rijhoogtes volgen de drie blokken op de screenshot (header, main, footer) */
	 .secties ul {
			display: grid;
			grid-template-rows: 120fr 515fr 158fr;
			gap: 6px;
			height: 480px;
			margin: 0;
			list-style: none;
			text-align: left;
	}
	 .secties li {
			position: relative;
			align-self: center;
			padding: 0.3em 0.8em;
			border-left: 6px solid #006EB2;
			border-radius: 0 8px 8px 0;
			background: #f0f5f9;
			font-size: 0.8em;
			line-height: 1.2;
	}
	 .secties li::before {
			content: "";
			position: absolute;
			left: -1.1em;
			top: 50%;
			margin-top: -0.45em;
			border: 0.45em solid transparent;
			border-left: 0;
			border-right: 0.6em solid #006EB2;
	}
	 .secties li span {
			display: block;
			color: #404040;
			font-size: 0.8em;
	}
	 .voorbeelden {
			display: flex;
			justify-content: center;
			gap: 1.5em;
			margin-top: 0.6em;
	}
	 .voorbeelden > div {
			width: 10em;
			padding: 1em 1.2em 1.4em 1.2em;
			border-top: 6px solid #006EB2;
			border-radius: 8px;
			background: #f0f5f9;
			font-size: 0.85em;
	}
	 .voorbeelden > div.goed {
			border-top-color: #1e7d32;
	}
	 .voorbeelden > div.slecht {
			border-top-color: #b3261e;
	}
	 .voorbeelden p {
			margin: 0 0 0.8em 0;
	}
	 p.oordeel {
			display: table;
			margin: 0 auto 0.6em auto;
			padding: 0.1em 0.8em;
			border-radius: 999px;
			background: #1e7d32;
			color: #fff;
			font-size: 0.75em;
			font-weight: bold;
	}
	 p.oordeel.slecht {
			background: #b3261e;
	}
	 .voorbeelden p:last-child {
			margin: 0.9em 0 0 0;
	}
	 p.oordeel span {
			margin-right: 0.3em;
	}
	 .knop {
			display: inline-block;
			padding: 0.7em 2em;
			border-radius: 6px;
			background: #006EB2;
			color: #fff;
			font-weight: bold;
	}
	 .nieuwskaart {
			width: 400px;
			margin: 0.5em auto 0 auto;
			border: 2px solid #ccc;
			background: #fff;
			text-align: left;
	}
	 .nieuwskaart img {
			display: block;
			width: 100%;
			max-width: none;
			height: 225px;
			margin: 0;
			border: 0;
			box-shadow: none;
	}
	 .nieuwskaart-tekst {
			height: 175px;
			overflow: hidden;
			padding: 12px 16px;
	}
	 .nieuwskaart p {
			margin: 0 0 6px 0;
			font-size: 20px;
			line-height: 1.25;
	}
	 .nieuwskaart p.nieuwskaart-meta {
			color: #595959;
			font-size: 16px;
	}
	 .nieuwskaart p.nieuwskaart-titel {
			font-weight: bold;
			font-size: 24px;
	}
	/* Tekstafstand volgens WCAG 1.4.12 */
	 .nieuwskaart.tekstafstand p {
			line-height: 1.5 !important;
			letter-spacing: 0.12em !important;
			word-spacing: 0.16em !important;
			margin-bottom: 2em !important;
	}
	 .nieuwskaart.meegroeien .nieuwskaart-tekst {
			height: auto;
	}
	p.vuistregel-label {
			display: table;
			margin: 0 auto 0.6em auto;
			padding: 0.15em 0.8em;
			border-radius: 999px;
			background: #006EB2;
			color: #fff;
			font-size: 0.6em;
			font-weight: bold;
			letter-spacing: 0.08em;
			text-transform: uppercase;
	}
	p.vuistregel-stelling {
			max-width: 22em;
			margin: 0 auto 1em auto;
			font-size: 1.15em;
			line-height: 1.3;
	}
	 ul.tegels {
			display: flex;
			justify-content: center;
			gap: 0.6em;
			margin: 0.4em 0 1em 0;
			list-style: none;
	}
	 ul.tegels li {
			width: 5.2em;
			padding: 0.7em 0.3em;
			border-top: 6px solid #006EB2;
			border-radius: 8px;
			background: #f0f5f9;
			font-size: 0.8em;
			font-weight: bold;
			text-align: center;
	}
	 p.tip {
			display: inline-block;
			margin: 0.8em 0 0 0;
			padding: 0.5em 0.9em;
			border-left: 6px solid #006EB2;
			border-radius: 0 8px 8px 0;
			background: #f0f5f9;
			font-size: 0.85em;
	}
	 ul.voorbeeldlijst {
			width: 100%;
			margin: 0.4em 0 0 1em;
	}
	 ul.voorbeeldlijst li {
			margin-bottom: 0.45em;
			font-size: 0.75em;
			line-height: 1.25;
	}
	 ul.voorbeeldlijst .rij {
			display: grid;
			grid-template-columns: 14em 1fr;
			gap: 1em;
			align-items: center;
	}
	 ul.voorbeeldlijst .kader {
			display: block;
			justify-self: start;
			padding: 0.4em 0.6em;
			border-left: 6px solid #006EB2;
			border-radius: 0 8px 8px 0;
			background: #f0f5f9;
	}
	 ul.voorbeeldlijst .kader img {
			display: block;
			max-height: 95px;
			margin: 0;
			border: 0;
			background: #fff;
			box-shadow: none;
	}
	 ul.voorbeeldlijst .voorgelezen {
			font-style: italic;
			color: #404040;
	}
	 .minipaginas {
			display: flex;
			justify-content: center;
			gap: 1.2em;
			margin-top: 0.4em;
	}
	 .minipagina {
			display: flex;
			flex-direction: column;
			gap: 6px;
			width: 120px;
			height: 160px;
			padding: 6px;
			border: 2px solid #ccc;
			border-radius: 6px;
			background: #fff;
	}
	 .minipagina span {
			display: block;
			border-radius: 3px;
	}
	 .minipagina .kop,
	 .minipagina .voet {
			height: 22px;
			background: #006EB2;
	}
	 .minipagina .inhoud {
			flex: 1;
			background: #f0f5f9;
	}
	 .vergelijking {
			display: flex;
			flex-direction: column;
			gap: 0.8em;
			width: 860px;
			margin: 0 auto;
	}
	 .vergelijking .paneel {
			padding: 0.6em 1em;
			border-left: 6px solid #1e7d32;
			border-radius: 0 8px 8px 0;
			background: #f0f5f9;
			text-align: left;
	}
	 .vergelijking .paneel.slecht {
			border-left-color: #b3261e;
	}
	 .vergelijking p.oordeel {
			margin: 0 0 0.5em 0;
	}
	 .vergelijking img {
			display: block;
			width: 100%;
			max-width: none;
			margin: 0;
			border: 0;
			box-shadow: none;
	}
	 .vergelijking .paneel p:last-child {
			margin: 0.4em 0 0 0;
			color: #404040;
			font-size: 0.7em;
	}
	 p.koppen-intro {
			margin: -0.6em 0 0.6em 0;
			color: #404040;
			font-size: 0.65em;
	}
	 .koppen-voorbeeld {
			display: flex;
			gap: 1em;
			text-align: left;
	}
	 .koppen-voorbeeld .paneel {
			flex: 1;
			padding: 0.6em 0.9em;
			border-top: 6px solid #006EB2;
			border-radius: 8px;
			background: #f0f5f9;
	}
	 .koppen-voorbeeld .paneel:first-child {
			flex: 1.35;
	}
	 .koppen-voorbeeld h5 {
			margin: 0 0 0.6em 0;
			color: #002943;
			font-size: 22px;
			font-weight: bold;
			line-height: 1.2;
	}
	 ul.koppenboom,
	 ul.koppenboom ul {
			margin: 0;
			list-style: none;
	}
	 ul.koppenboom ul {
			margin-left: 1.4em;
	}
	 ul.koppenboom li {
			margin: 0.3em 0;
			line-height: 1.2;
	}
	 ul.koppenboom p {
			margin: 0.3em 0 0.4em 0;
			color: #404040;
			font-size: 16px;
			line-height: 1.3;
	}
	 ul.koppenboom .niveau {
			display: inline-block;
			min-width: 2.1em;
			margin-right: 0.3em;
			padding: 0.1em 0.3em;
			border-radius: 4px;
			background: #002943;
			color: #fff;
			font-size: 13px;
			font-weight: bold;
			text-align: center;
			vertical-align: middle;
	}
	 ul.koppenboom .kop1 { font-size: 30px; font-weight: bold; }
	 ul.koppenboom .kop2 { font-size: 24px; font-weight: bold; }
	 ul.koppenboom .kop3 { font-size: 19px; font-weight: bold; }
	 table.stijlnamen {
			width: 100%;
			margin: 0;
			border-collapse: separate;
			border-spacing: 0.4em 0.5em;
	}
	 table.stijlnamen th,
	 table.stijlnamen td {
			padding: 0;
			border: 0;
			text-align: left;
	}
	 table.stijlnamen th {
			text-shadow: none;
			line-height: 1.4;
	}
	 table.stijlnamen p.oordeel {
			display: inline-block;
			margin: 0;
			font-size: 15px;
			line-height: 1.4;
	}
	 h4.koppen-titel {
			font-size: 1.05em;
	}
	 table.stijlnamen td {
			padding: 0.35em 0.6em;
			border: 2px solid #1e7d32;
			border-radius: 8px;
			background: #fff;
			font-size: 18px;
			font-weight: bold;
	}
	 table.stijlnamen td:first-child {
			border-color: #b3261e;
	}
	 p.paneel-noot {
			margin: 0.6em 0 0 0;
			color: #404040;
			font-size: 15px;
			line-height: 1.35;
	}
	 .secties-contrast {
			display: flex;
			justify-content: center;
			gap: 1.5em;
			margin-top: 0.4em;
	}
	 .secties-contrast > div {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: 11em;
			padding: 0.8em 0.8em 0.4em 0.8em;
			border-radius: 8px;
			background: #f0f5f9;
	}
	 .secties-contrast p {
			margin: 0.5em 0 0 0;
			font-size: 0.7em;
			line-height: 1.35;
	}
	 .ratio {
			color: #006EB2;
			font-size: 1.3em;
	}
	 .voorbeelden p.voorgelezen {
			color: #404040;
			font-style: italic;
	}
	/* Label voor slides over annotaties in design files: <p class="vuistregel-label annotatie">Annotatie</p> */
	 p.vuistregel-label.annotatie {
			background: #6d28d9;
	}
	 .productkaart {
			width: 280px;
			margin: 0.4em auto 0 auto;
			padding: 16px 18px 18px 18px;
			border: 1px solid #ccc;
			border-radius: 12px;
			background: #fff;
			text-align: left;
	}
	 .productkaart img {
			display: block;
			width: 100%;
			max-width: none;
			margin: 0;
			border: 0;
			box-shadow: none;
	}
	 .productkaart-leeg {
			height: 180px;
			background: #000;
			color: #fff;
			font-size: 60px;
			font-weight: bold;
			line-height: 180px;
			text-align: center;
	}
	 .productkaart p {
			margin: 12px 0 0 0;
			font-size: 20px;
			line-height: 1.25;
	}
	 .productkaart .link-voorbeeld {
			color: #000;
			text-decoration: underline;
	}
	 .productkaart p.productkaart-korting {
			color: #c8102e;
	}
	 .productkaart p.productkaart-korting strong {
			font-size: 32px;
	}
	 .productkaart .productkaart-knop {
			display: block;
			padding: 10px 16px;
			border-radius: 999px;
			background: #fde8ea;
			color: #c8102e;
			font-size: 16px;
			font-weight: bold;
	}
	/* Kleinere toelichting direct onder een slidetitel: <p class="ondertitel">...</p> */
	 p.ondertitel {
			margin: -0.6em 0 0.6em 0;
			color: #404040;
			font-size: 0.65em;
	}
</style>

