<section id="word-tables">
  <section>
    <h1>Tables</h1>
  </section>

  <section>
    <h2>Keep table simple</h2>
    <ul>
      <li>Avoid merged cells</li>
      <li>Divide complex tables into multiple simpler tables</li>
      <li>Only use tables for data tables, not for layout</li>
    </ul>
  </section>

  <section>
    <img
      src="https://images.anysurfer.be/table/tableau_simple.png"
      alt="example simple table with one heading row and one heading column"
    />
  </section>

  <section>
    <img
      class="stretch"
      src="https://images.anysurfer.be/table/tableau_trop_complexe.png"
      alt="table with multiple levels of headings"
    />
  </section>

  <section>
    <h2>Mark first row and/or first column as table header</h2>
    <p>
      <img
        src="https://images.anysurfer.be/applications/Word365/table_headers.jpg"
        alt=""
      />
    </p>
    <ul>
      <li>Check "header row" to make column headings</li>
      <li>Check "First column" to make line headings</li>
    </ul>
  </section>
</section>
