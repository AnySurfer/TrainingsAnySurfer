---
import Favicon from '@assets/favicon.png'

/**
 * Shared head element with metadata, favicon and nofollow, noindex directives.
 * @param {string} title - Page title.
 * @param {string} [description='AnySurfer'] - Page description.
 * @slot default - Additional head elements.
 * @example <UiHead title="My training" />
 */
interface Props {
  title: string
  description?: string
}

const { title, description = 'AnySurfer', ...props } = Astro.props
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="nofollow, noindex" />
  <link rel="icon" href={Favicon.src} type={`image/${Favicon.format}`} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <slot />
  <!-- <link rel="sitemap" href="/sitemap-index.xml" /> -->
</head>
