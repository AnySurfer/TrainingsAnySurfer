  <section>
    <h2>Voordelen van toegankelijke multimedia</h2>
  </section>

  <section>
    <ul>
      <li>Je bereikt meer mensen</li>
      <li>Video kan drempelverlagend zijn</li>
      <li>Beter voor SEO</li>
      <li>Voldoen aan toegankelijkheidsrichtlijnen WCAG</li>
    </ul>
  </section>
