<section id="capabilities">
    <section>
        <h1>Ce qui n'est pas possible</h1>
        <ul>
            <li>Améliorer le contraste</li>
            <li>Ajouter des alternatives textuelles visibles</li>
            <li>Simplifier un tableau</li>
        </ul>
    </section>

    <section>
        <h1>Ce qui est possible</h1>
        <ul>
            <li>Modifier les balises existantes pour en améliorer la structure</li>
            <li>Baliser complètement le document</li>
            <li>Remplir les alternatives de texte</li>
            <li>Déterminer l'ordre de lecture</li>
            <li>Modifier les propriétés d'un document</li>
        </ul>
    </section>
</section>
