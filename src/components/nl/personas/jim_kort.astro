<section>
  <h2>Probeer het zelf</h2>
  <ul>
    <li>
      <kbd>TAB</kbd> : naar volgend interactief element
    </li>
    <li>
      <kbd>Shift</kbd> + <kbd>TAB</kbd> : naar vorig interactief element
    </li>
    <li>
      <kbd>ENTER</kbd> : link of knop activeren
    </li>
    <li>
      <kbd>Spatie</kbd> : checkbox of radioknop selecteren
    </li>
    <li>Pijltjes beneden en boven: selectie maken in een lijst</li>
  </ul>
</section>

