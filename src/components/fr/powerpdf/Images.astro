---
import ImageTagging007 from '@assets/img/powerpdf/tagging-007.png'
import ImageTagging008 from '@assets/img/powerpdf/tagging-008.png'
---

<section id="images">
    <section>
        <h1>Baliser une image</h1>
        <ul>
            <li>Édition > Modifier un objet</li>
            <li>Cliquer sur l'image à sélectionner</li>
            <li>Balises > Nouvelle balise > Figure</li>
            <li>
                <p>Balises > Créer une balise à partir de la sélection</p>
                <img src={ImageTagging007.src} alt="">
            </li>
        </ul>
    </section>

    <section>
        <h2>Ajouter une alternative textuelle</h2>
        <ul>
            <li>Clic droit sur la balise Figure > Propriétés...</li>
            <li>Pro</li>
            <li>
                <p>Onglet Balises > Texte de remplacement</p>
                <img src={ImageTagging008.src} alt="">
            </li>
        </ul>
    </section>

    <section>
        <h2>Image décorative</h2>
        <ul>
            <li>Remplacer la balise Figure par la balise Artifact</li>
            <li>Autre méthode : modifier les images sans texte alternatif après vérification</li>
        </ul>
    </section>
</section>
