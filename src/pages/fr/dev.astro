---
	import Layout from '@layouts/LayoutSlides.astro'

	const title = 'Développer un site web accessible'
---

<Layout title={ title }>
    <!-- Intro -->
    <FrSharedTitle title={ title } />
    <FrDevToC />

    <!-- Structure -->
    <FrDevStructure />
    <FrDevStructureBase />
    <FrDevStructureSemantic />
    <FrDevStructureOrder />
    <FrDevStructureAria />
    
    <!-- Interactions -->
    <FrDevInteractions />
    <FrDevInteractionsNavigation />
    <FrDevInteractionsKeyboard />
    <FrDevInteractionsPointer />
    <FrDevInteractionsResponsive />
    
    
    <!-- Content -->
    <FrDevContent />
    <FrDevContentLinks />
    <FrDevContentPictures />
    <FrDevContentForms />
    <FrDevContentComponents />
    <FrDevContentTables />
    <!-- <FrDevContentMedia /> -->
    <FrDevContentDistractions />

    <!-- Color -->
    <FrDevColor />
    
    <!-- Docs /> -->
    <!-- <FrDevDocs /> -->
    
    <!-- Test -->
    <FrDevTesting />
    
    <!-- Documentation -->
    <FrDevDocumentation />
    
    <!-- Contact -->
    <FrDevContact />
</Layout>
