<LayoutSyllabus title={title} lang="fr" slidesHref={`${base}/fr/redac/`}>
  <FrRedacIntroduction />
  <FrRedacPageTitles />
  <FrRedacLinks />
  <FrRedacTextStructure />
  <FrRedacImages />
  <FrRedacColor />
  <FrRedacTables />
  <FrRedacVideoAudio />
  <FrRedacDocuments />
  <FrRedacConclusion />
</LayoutSyllabus>
