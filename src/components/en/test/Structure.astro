                    <p><img src="https://images.anysurfer.be/table/wrong_table_structure.png" alt="incorrect table with outlined table cells (web dev extension)"></p>

        </section>

        <section>
                    <p><img src="https://images.anysurfer.be/table/correct_table_structure.png" alt="correct table with outlined table cells (web dev extension)"></p>

        </section>
