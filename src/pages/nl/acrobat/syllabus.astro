---
import LayoutSyllabus from '@layouts/LayoutSyllabus.astro'

const title = 'Toegankelijke PDF met Acrobat'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!-- Source : Input/reveal/acrobat_nl.html -->
<LayoutSyllabus title={title} lang="nl" slidesHref={`${base}/nl/acrobat/`}>
  <!-- Introduction -->

  <NlAcrobatIntro />

  <!-- Document Properties -->
  <NlAcrobatDocumentProperties />

  <!-- PDF tags -->
  <NlAcrobatTags />

  <!-- Add tags -->
  <NlAcrobatAddTags />

  <!-- Method one -->
  <NlAcrobatMethodOne />

  <!-- Method two -->
  <NlAcrobatMethodTwo />

  <!-- Tips -->
  <NlAcrobatTips />

  <!-- Image -->
  <NlAcrobatImage />

  <!-- Link -->
  <NlAcrobatLink />

  <!-- Exercise -->
  <NlAcrobatExercise />
</LayoutSyllabus>
