<section id="semantiek">
  <!-- Semantiek -->
  <section>
    <h1>Semantiek</h1>
  </section>
  <section>
    <p>Gebruik beschrijvende HTML-elementen:</p>
    <ul>
      <li>Koppen: h1-h6</li>
      <li>Lijsten: ul/ol</li>
      <li>Tabellen: th en caption</li>
      <li>Blokken: header, nav, main, footer</li>
    </ul>
  </section>
  <section>
    <h2>Koppen</h2>
    <ul>
      <li>Wat er als kop uitziet, is ook als kop gemarkeerd.</li>
      <li>Niet enkel vet en groter lettertype</li>
      <li>Kies juiste kopniveau en respecteer hiërarchie in kopniveau's</li>
    </ul>
  </section>
  <section>
    <h2>Hoe testen?</h2>
    <ul>
      <li>Gebruik de Web Developer Toolbar,</li>
      <li>Vink aan Outline > Show element tag names</li>
      <li>Kies Outline &gt; Outline Headings</li>
      <li>Koppen zijn nu gemarkeerd en het kopniveau is aangegeven.</li>
    </ul>
  </section>

  <section>
    <p>
      <img
        src="https://images.anysurfer.be/structure/outline_headings.png"
        alt="screenshot outline headings "
      />
    </p>
  </section>
