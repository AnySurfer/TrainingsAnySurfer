---
/**
 * Code block (pre > code) for Reveal.js Highlight syntax highlighting.
 * @param {string} [language] - Language used in the language-{language} class.
 * @slot default - Code to display, supplied as text or with is:raw.
 * @example <UiCode language="html">{'<button>Submit</button>'}</UiCode>
 */
interface Props {
  language?: string
}
// https://highlightjs.readthedocs.io/en/latest/supported-languages.html
const { language } = Astro.props
---

<pre>
    <code class:list={{[`language-${language}`]: language}} data-trim>
        <slot set:html is:raw/>
    </code>
</pre>
