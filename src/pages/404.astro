---
import Layout from '@layouts/Layout.astro'
import { defaultLang, ui } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const locale = Astro.currentLocale ?? defaultLang
const lang = Object.hasOwn(ui, locale)
  ? (locale as keyof typeof ui)
  : defaultLang
const t = useTranslations(lang)
---

<Layout title={t('error-404.title')} lang={lang}>
  <div class="error-page">
    <p class="error-code" aria-hidden="true">
      404
    </p>
    <div class="page-intro">
      <p class="eyebrow">{t('error-404.label')}</p>
      <h1>{t('error-404.title')}</h1>
      <p>{t('error-404.description')}</p>
    </div>
    <a class="home-link" href={`${base}/${lang}/training/`}>
      {t('error-404.home')}
    </a>
  </div>
</Layout>

<script>
  import { getLangFromUrl, useTranslations } from '../i18n/utils'
  import { translateDocument } from '../i18n/client'

  // GitHub Pages serves the same static 404.html for every missing URL.
  const lang = getLangFromUrl(
    new URL(window.location.href),
    import.meta.env.BASE_URL,
  )
  const t = useTranslations(lang)
  translateDocument(lang, t('error-404.title'))
  const updateText = (selector: string, text: string) => {
    const element = document.querySelector(selector)
    if (element) element.textContent = text
  }
  updateText('.error-page .eyebrow', t('error-404.label'))
  updateText('.error-page h1', t('error-404.title'))
  updateText(
    '.error-page .page-intro > p:last-child',
    t('error-404.description'),
  )
  updateText('.error-page .home-link', t('error-404.home'))
  const recoveryLink = document.querySelector<HTMLAnchorElement>(
    '.error-page .home-link',
  )
  if (recoveryLink) {
    recoveryLink.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${lang}/training/`
  }
</script>

<style>
  .error-page {
    max-width: 52rem;
    padding-block: 1rem 3rem;
  }

  .error-code {
    margin: 0 0 1.5rem;
    color: var(--as-text);
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .error-code::after {
    content: '';
    display: block;
    width: 4rem;
    height: 0.4rem;
    margin-top: 1rem;
    border-radius: 1rem;
    background: #ffb721;
  }

  .home-link {
    display: inline-block;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--as-control-border);
    border-radius: 0.7rem;
    background: var(--as-control-background);
    font-weight: 600;
  }

  .home-link:hover {
    background: var(--as-control-hover);
  }
</style>
